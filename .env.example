# ABCDE Projects — 환경 변수
# 이 파일은 키 이름만 적는다. 값은 .env.local(로컬)과 Vercel 대시보드(운영)에만 둔다.
# 새 Supabase 프로젝트 만드는 순서는 docs/01-실행-가이드.md 를 본다.

# ── 사이트 ──────────────────────────────────────────────────
# 운영 도메인. 이메일 인증 링크·OG 태그의 기준 URL. 로컬은 비워 두면 http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ── Supabase (필수) ────────────────────────────────────────
# Project Settings → API. NEXT_PUBLIC_ 은 브라우저에 노출되는 값이다(publishable/anon 키만).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 구형 프로젝트는 publishable 대신 anon 키를 쓴다. 둘 중 하나만 있으면 된다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. RLS 를 우회한다. 관리자 작업·사용량 기록·시드 스크립트에서만 쓴다. 브라우저 번들 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── 사용량 통제 ────────────────────────────────────────────
# 승인된 사용자 1인의 월 기본 한도(USD). 관리자 화면에서 사용자별로 덮어쓸 수 있다.
DEFAULT_MONTHLY_BUDGET_USD=5
# 분당 LLM 호출 허용 횟수(사용자별)
RATE_LIMIT_PER_MINUTE=20

# ── AI 제공자 ──────────────────────────────────────────────
# 서버 전용. 브라우저에 절대 노출하지 않는다.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ── AIEEWA (서술형 문항 생성·채점) ────────────────────────
# 문항 생성과 채점에 쓰는 모델. 비우면 gpt-4o.
# 주의 1: 구조화 출력(json_schema)을 지원하는 모델이어야 한다.
# 주의 2: temperature 를 받지 않는 모델(일부 추론 모델)로 바꾸면 호출이 실패한다.
# 주의 3: src/lib/usage/pricing.ts 의 단가표에 없는 모델은 비싸게 추정되어 한도가 빨리 찬다.
AIEEWA_MODEL=
# RAG 임베딩 모델. 비우면 text-embedding-3-small(1536차원).
# 바꾸면 aieewa_document_chunks.embedding 의 차원이 달라지므로 마이그레이션을 새로 써야 한다.
AIEEWA_EMBEDDING_MODEL=
